#!/bin/sh
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python=${OH_MY_USAGE_PYTHON:-python3}
if [ -r "$root/python-path" ]; then
  IFS= read -r python < "$root/python-path"
fi
export PYTHONPATH="$root"
unset PYTHONHOME PYTHONUSERBASE
export PYTHONDONTWRITEBYTECODE=1
exec "$python" -m oh_my_usage "$@"
